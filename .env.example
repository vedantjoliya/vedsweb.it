# VedsWeb Studio Environment Configuration
# Optional: Set custom Cloud Database REST API URL and Secret API Key for multi-device live cloud sync

# Cloud Database REST API URL (e.g. JSONBin bin URL, Supabase REST API, Upstash Redis, or Firebase RTDB)
VITE_CLOUD_API_URL=https://api.jsonbin.io/v3/b/YOUR_BIN_ID

# Optional: Master API Key for write access to private bins
VITE_CLOUD_API_KEY=$2a$10$YOUR_MASTER_KEY
